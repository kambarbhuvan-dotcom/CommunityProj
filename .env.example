# =============================================================================
# SolarConnect – Supabase Environment Configuration
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Obtain your project credentials from your Supabase Dashboard:
#   https://supabase.com/dashboard/project/_/settings/api
#
# NOTE: Only use the public 'anon' key here.
# NEVER place your 'service_role' key in client-side .env files!
# =============================================================================

# Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Project Public Anon Key (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key-here
